# SQLite demonstration configuration (default in this repository)
DATABASE_URL="file:./dev.db"
# For PostgreSQL production deployment:
# DATABASE_URL="postgresql://user:password@localhost:5432/aicte_complaints?schema=public"

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
